@startuml base_de_datos
' Modelo de la base de datos (PostgreSQL)
' Responsable: David
title RecetApp - Base de datos

hide circle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #7366FE
  HeaderBackgroundColor #F3F1FF
}

entity usuarios {
  * id : SERIAL <<PK>>
  --
  nombre : VARCHAR(100)
  correo : VARCHAR(150) <<UNIQUE>>
  contrasena_hash : VARCHAR(255)
  rol : VARCHAR(20)
  activo : BOOLEAN
  creado_en : TIMESTAMP
}

entity recetas {
  * id : VARCHAR(10) <<PK>>
  --
  nombre : VARCHAR(150)
  categoria : VARCHAR(60)
  descripcion : TEXT
  dificultad : VARCHAR(10)
  tiempo_min : INTEGER
  porciones : INTEGER
  vegetariano : BOOLEAN
  vegano : BOOLEAN
  sin_gluten : BOOLEAN
}

entity receta_ingredientes {
  * id : SERIAL <<PK>>
  --
  receta_id : VARCHAR(10) <<FK>>
  clave : VARCHAR(60) (catálogo JSON)
  cantidad : DECIMAL
  unidad : VARCHAR(30)
  opcional : BOOLEAN
}

entity pasos {
  * id : SERIAL <<PK>>
  --
  receta_id : VARCHAR(10) <<FK>>
  numero : INTEGER
  instruccion : TEXT
}

entity despensa {
  * id : SERIAL <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  clave : VARCHAR(60) (catálogo JSON)
}

entity favoritos {
  * id : SERIAL <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  receta_id : VARCHAR(10) <<FK>>
  creado_en : TIMESTAMP
}

entity historial {
  * id : SERIAL <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  receta_id : VARCHAR(10) <<FK>>
  visto_en : TIMESTAMP
}

entity plan_semanal {
  * id : SERIAL <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  receta_id : VARCHAR(10) <<FK>>
  dia : VARCHAR(10)
  estado : VARCHAR(20)
}

entity recetas_propuestas {
  * id : SERIAL <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  nombre : VARCHAR(150)
  descripcion : TEXT
  estado : VARCHAR(20)
  motivo_rechazo : TEXT
  creado_en : TIMESTAMP
}

entity bitacora {
  * id : SERIAL <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  accion : VARCHAR(200)
  fecha : TIMESTAMP
}

recetas ||--o{ receta_ingredientes
recetas ||--o{ pasos
usuarios ||--o{ despensa
usuarios ||--o{ favoritos
recetas ||--o{ favoritos
usuarios ||--o{ historial
recetas ||--o{ historial
usuarios ||--o{ plan_semanal
recetas ||--o{ plan_semanal
usuarios ||--o{ recetas_propuestas
usuarios |o--o{ bitacora

@enduml
