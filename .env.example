# Copia este archivo con el nombre .env y pon tu contraseña de PostgreSQL.
# El archivo .env no se sube a GitHub.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=recetapp

# Llaves de AWS para reconocer fotos (las da David en privado, no compartirlas)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
